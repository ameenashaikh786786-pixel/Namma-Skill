<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NammaSkill" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar and Nav bar color. -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/background</item>
        <!-- Customize your light theme here. -->
    </style>

    <style name="Widget.NammaSkill.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/background</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
